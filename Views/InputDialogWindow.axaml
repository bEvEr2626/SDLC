<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CakeCalculator.Views.InputDialogWindow"
        Title="Ввод данных" Width="400" Height="520"
        WindowStartupLocation="CenterOwner" CanResize="False">

    <ScrollViewer>
        <StackPanel Margin="15" Spacing="8">
            <TextBlock Text="Количество сигарет в день:" />
            <TextBox Name="CigarettesPerDayInput" />

            <TextBlock Text="Цена пачки сигарет (руб):" />
            <TextBox Name="PackPriceInput" />

            <TextBlock Text="Смолы в 1 сигарете (мг):" />
            <TextBox Name="TarInput" />

            <TextBlock Text="Никотина в 1 сигарете (мг):" />
            <TextBox Name="NicotineInput" />

            <TextBlock Text="Стаж курения (лет):" />
            <TextBox Name="YearsInput" />

            <TextBlock Text="Цена одного тортика (руб):" />
            <TextBox Name="CakePriceInput" />

            <TextBlock Text="Цена одного апельсина (руб):" />
            <TextBox Name="OrangePriceInput" />

            <TextBlock Name="ErrorTextBlock" Foreground="#FF5252" TextWrapping="Wrap" Margin="0,5,0,0" FontWeight="Bold"/>

            <Button Content="Рассчитать" 
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" 
                    Margin="0,10,0,0" Height="35" Click="OnSaveClick" />
        </StackPanel>
    </ScrollViewer>
</Window>